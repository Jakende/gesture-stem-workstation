#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_dir"

processor_port="${GSW_PROCESSOR_PORT:-8766}"
export VITE_PROCESSOR_URL="http://127.0.0.1:$processor_port"
.venv/bin/uvicorn gesture_stem_processor.api:app --app-dir apps/processor/src --reload --port "$processor_port" &
processor_pid=$!
trap 'kill "$processor_pid" 2>/dev/null || true' EXIT INT TERM
npm run dev
